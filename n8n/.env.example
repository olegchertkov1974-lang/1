# === PostgreSQL ===
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=n8n_password

# === n8n ===
N8N_PORT=5678
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme

# === Domain & Protocol ===
# Set your domain name (without protocol)
N8N_HOST=localhost
# http or https
N8N_PROTOCOL=http
# Full webhook URL (used for triggers)
WEBHOOK_URL=http://localhost:5678/

# === Timezone ===
GENERIC_TIMEZONE=Europe/Moscow

# === SSL (optional, for nginx proxy) ===
# Set these if using the nginx + SSL profile
# SSL_EMAIL=your-email@example.com
# DOMAIN=n8n.yourdomain.com
