# ===================================================
# Bybit API (TRADE permission only, NO withdrawal!)
# ===================================================
BYBIT_API_KEY=your_api_key_here
BYBIT_API_SECRET=your_api_secret_here
BYBIT_TESTNET=true

# ===================================================
# Telegram Notifications
# ===================================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=543663073

# ===================================================
# OpenRouter AI Filter
# ===================================================
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=anthropic/claude-sonnet-4-20250514
AI_FILTER_ENABLED=true
AI_MIN_CONFIDENCE=60

# ===================================================
# n8n Integration
# ===================================================
# URL where n8n listens for webhooks from the bot
N8N_WEBHOOK_URL=https://quiximoloymer.beget.app/webhook/trading-bot
# Port for the bot's own webhook server (n8n calls this)
WEBHOOK_PORT=3001
WEBHOOK_HOST=127.0.0.1
# Shared secret for webhook auth
WEBHOOK_SECRET=your_random_secret_here

# ===================================================
# Trading Settings
# ===================================================
RISK_PCT=1
MIN_RR=3
MAX_POSITIONS=3
TIMEFRAMES=15m,1h,4h
POLL_INTERVAL_MS=60000
VOLUME_THRESHOLD=1000000

# ===================================================
# Logging
# ===================================================
LOG_LEVEL=info
